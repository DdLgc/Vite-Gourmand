
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{% block title %}Vite & Gourmand{% endblock %}</title>

    {% block stylesheets %}
        <style>
            body {
                margin: 0;
                font-family: Arial, sans-serif;
                color: #242424;
                background: #f8f7f4;
            }

            .container {
                width: min(1100px, 90%);
                margin: 0 auto;
            }

            header, footer {
                padding: 1.5rem 0;
                background: #24382e;
                color: white;
            }

            header a, footer a {
                color: white;
                text-decoration: none;
            }

            main {
                min-height: 65vh;
                padding: 3rem 0;
            }

            .menu-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
                gap: 1.5rem;
            }

            .menu-card {
                padding: 1.5rem;
                border-radius: 12px;
                background: white;
                box-shadow: 0 2px 12px #00000012;
            }

            .button {
                display: inline-block;
                padding: .75rem 1rem;
                border-radius: 6px;
                background: #24382e;
                color: white;
                text-decoration: none;
            }

            .price {
                font-size: 1.3rem;
                font-weight: bold;
            }
        </style>
    {% endblock %}
</head>
<body>
    <header>
        <div class="container">
            <a href="{{ path('app_menu_index') }}">Vite & Gourmand</a>
        </div>
    </header>

    <main class="container">
        {% block body %}{% endblock %}
    </main>

    <footer>
        <div class="container">
            <p>&copy; {{ 'now'|date('Y') }} Vite & Gourmand</p>
        </div>
    </footer>
</body>
</html>
