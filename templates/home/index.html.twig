{% extends 'base.html.twig' %}

{% block title %}Accueil — Vite & Gourmand{% endblock %}

{% block body %}
    <section class="hero">
        <div class="container">
            <span class="eyebrow">Traiteur à Bordeaux depuis 25 ans</span>

            <h1>Le plaisir de recevoir,<br>le goût du partage.</h1>

            <p>
                Julie et José vous accompagnent dans vos événements
                avec des menus préparés pour chaque occasion.
            </p>

            <a class="button button-primary" href="{{ path('app_menu_index') }}">
                Découvrir nos menus
            </a>
        </div>
    </section>

    <section class="section">
        <div class="container">
            <span class="eyebrow">Notre sélection</span>
            <h2>Des menus pour chaque occasion</h2>

            {% if menus is empty %}
                <p>Aucun menu disponible pour le moment.</p>
            {% else %}
                <div class="menu-grid">
                    {% for menu in menus %}
                        <article class="menu-card">
                            <div class="menu-card-content">
                                <span class="eyebrow">{{ menu.theme }}</span>

                                <h3>{{ menu.title }}</h3>

                                <p>{{ menu.description }}</p>

                                <div class="menu-card-meta">
                                    <span>Dès {{ menu.minimumPeople }} personnes</span>

                                    <strong>
                                        {{ (menu.basePriceCents / 100)|number_format(2, ',', ' ') }} €
                                        / personne
                                    </strong>
                                </div>

                                <a class="text-link"
                                   href="{{ path('app_menu_show', {id: menu.id}) }}">
                                    Voir le menu →
                                </a>
                            </div>
                        </article>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </section>
{% endblock %}