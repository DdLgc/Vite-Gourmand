{% extends 'base.html.twig' %}

{% block title %}Gestion des employés | Vite & Gourmand{% endblock %}

{% block body %}
    <section class="container admin-dashboard">
        <h1>Gestion des employés</h1>

        <p>Consultez les comptes employés de Vite & Gourmand.</p>

        {% if employees is not empty %}
            <div class="table-responsive">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h1 class="h3 mb-0">Gestion des employés</h1>

                    <a
                        href="{{ path('app_admin_employee_new') }}"
                        class="btn btn-primary"
                    >
                        <i class="bi bi-person-plus me-2" aria-hidden="true"></i>
                        Créer un employé
                    </a>
                </div>

                <table class="employees-table">
                    <thead>
                        <tr>
                            <th scope="col">Nom</th>
                            <th scope="col">Prénom</th>
                            <th scope="col">Email</th>
                            <th scope="col">Téléphone</th>
                            <th scope="col">Statut</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for employee in employees %}
                            <tr>
                                <td>{{ employee.lastName }}</td>
                                <td>{{ employee.firstName }}</td>
                                <td>{{ employee.email }}</td>
                                <td>{{ employee.phone }}</td>
                                <td>
                                    {{ employee.active ? 'Actif' : 'Inactif' }}
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <a
                                            href="{{ path('app_admin_employee_edit', { id: employee.id }) }}"
                                            class="btn btn-sm btn-outline-primary"
                                            aria-label="Modifier {{ employee.firstName }} {{ employee.lastName }}"
                                        >
                                            Modifier
                                        </a>

                                        {% if employee.active %}
                                            <form
                                                method="post"
                                                action="{{ path('app_admin_employee_deactivate', { id: employee.id }) }}"
                                                onsubmit="return confirm('Voulez-vous vraiment désactiver ce compte employé ?');"
                                            >
                                                <input
                                                    type="hidden"
                                                    name="_token"
                                                    value="{{ csrf_token('deactivate_employee_' ~ employee.id) }}"
                                                >

                                                <button
                                                    type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    aria-label="Désactiver {{ employee.firstName }} {{ employee.lastName }}"
                                                >
                                                    Désactiver
                                                </button>
                                            </form>
                                        {% else %}
                                            <span class="text-muted">Compte désactivé</span>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <p>Aucun employé enregistré.</p>
        {% endif %}
    </section>
{% endblock %}
