{% extends 'base.html.twig' %}

{% block title %}Administration | Vite & Gourmand{% endblock %}

{% block body %}
    <section class="container admin-dashboard">
        <h1>Tableau de bord administrateur</h1>

        <p>
            Bienvenue dans votre espace d'administration,
            {{ app.user.firstName }}.
        </p>

        <div class="dashboard-grid">
            <article class="dashboard-card">
                <h2>Gestion des employés</h2>
                <p>Créer, modifier et désactiver les comptes employés.</p>
            </article>

            <article class="dashboard-card">
                <h2>Gestion des commandes</h2>
                <p>Consulter les commandes et suivre leur évolution.</p>
            </article>

            <article class="dashboard-card">
                <h2>Gestion des menus</h2>
                <p>Consulter et administrer les menus proposés.</p>
            </article>

            <article class="dashboard-card">
                <h2>Statistiques</h2>
                <p>Analyser les commandes et le chiffre d'affaires.</p>
            </article>
        </div>
    </section>
{% endblock %}