{
    "compilerOptions": {
        "target": "ES2020",
        "module": "es2020",
        "lib": ["ES2020", "DOM"],
        "strict": true,
        "rootDir": "./assets/ts",
        "outDir": "./public/js",
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "noEmitOnError": true
    },
    "include": ["assets/ts/**/*.ts"]
}
